
#Область ОбработчикиСобытий

Функция ПроверитьДоступность(Запрос)
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки("Ok", КодировкаТекста.UTF8);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	Возврат Ответ;
	
КонецФункции

Функция ПолучитьТокен(Запрос)
	
	Попытка
		Возврат ОбменРемонтАттракционовМобильный.ПолучитьТокен(Запрос);
	Исключение
		ИмяМетода = "GET /token";
		Возврат ОтветОшибки(ИмяМетода, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

Функция ПолучитьЗаказНаряды(Запрос)
	
	Попытка
		Ответ = Новый HTTPСервисОтвет(200);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	КОЛИЧЕСТВО(ЗаказНаряд.Ссылка) КАК КоличествоДокументов
			|ИЗ
			|	Документ.ЗаказНаряд КАК ЗаказНаряд";
		Выборка = Запрос.Выполнить().Выбрать();
		
		Выборка.Следующий();
		
		Результат = Новый Структура;
		Результат.Вставить("Количество", Выборка.КоличествоДокументов);
		
		ТелоОтвета = ЗаписатьЗначениеJSON(Результат);
		
		Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
		Ответ.Заголовки.Вставить("Content-Type", "application/json");
		
		Возврат Ответ;
	Исключение
		ИмяМетода = "GET /order-outfits";
		Возврат ОтветОшибки(ИмяМетода, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции


Функция ПолучитьСправочники(Запрос)
	
	Попытка
		Возврат ОбменРемонтАттракционовМобильный.ПолучитьСправочники(Запрос);
	Исключение
		ИмяМетода = "GET /catalogs";
		Возврат ОтветОшибки(ИмяМетода, ИнформацияОбОшибке());
	КонецПопытки;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Формирует ответ HTTP-сервиса с кодом 500 и записывает информацию об ошибке в журнал регистрации.
//
// Параметры:
//  ИмяМетода - Строка - идентификатор метода HTTP-сервиса, например "GET /token".
//  ИнформацияОбОшибке - ИнформацияОбОшибке - информация об исключении.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ с кодом состояния 500.
//
Функция ОтветОшибки(ИмяМетода, ИнформацияОбОшибке)
	
	ИмяСобытия = СтрШаблон("РемонтАттракционовМобильный.%1.Ошибка", ИмяМетода);
	ЗаписьЖурналаРегистрации(ИмяСобытия, УровеньЖурналаРегистрации.Ошибка, 
		Метаданные.HTTPСервисы.РемонтАттракционовМобильный,,
		ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
	
	Ответ = Новый HTTPСервисОтвет(500);
	Ответ.УстановитьТелоИзСтроки("Внутренняя ошибка сервера", КодировкаТекста.UTF8);
	Ответ.Заголовки.Вставить("Content-Type", "text/plain; charset=utf-8");
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

