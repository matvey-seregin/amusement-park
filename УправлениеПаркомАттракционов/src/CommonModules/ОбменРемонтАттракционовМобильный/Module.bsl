
#Область ПрограммныйИнтерфейс

// Формирует токен доступа для мобильного приложения.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос HTTP-сервиса.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ с признаком поддержки токена доступа и значением токена.
//
Функция ПолучитьТокен(Запрос) Экспорт
	
	Результат = Новый Структура;
	Результат.Вставить("ПоддерживаетсяТокенДоступа", Ложь);
	Результат.Вставить("ТокенДоступа", "");
	
	УстановитьПривилегированныйРежим(Истина);
	Эмитент = Справочники.ЭмитентыJWT.ЭмитентМобильногоПриложения;
	Используется = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Эмитент, "Используется");
	Если Используется Тогда
		Результат.ТокенДоступа = ТокеныДоступа.СформироватьТокенДоступа(Эмитент);
		Результат.ПоддерживаетсяТокенДоступа = Истина;
	КонецЕсли;
	
	Ответ = Новый HTTPСервисОтвет(200);
	
	ТелоОтвета = ЗаписатьЗначениеJSON(Результат);
	
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Возврат Ответ;
	
КонецФункции

// Возвращает порцию изменений справочников, зарегистрированных на узле плана обмена ОбменРемонтАттракционов.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос HTTP-сервиса.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ, содержащий массив описаний измененных объектов и признак наличия данных.
//
Функция ПолучитьСправочники(Запрос) Экспорт
	
	Узел = ИдентифицироватьМобильноеУстройство(Запрос);
	
	НомерПринятогоСтрока = Запрос.Заголовки.Получить("x-last-message");
	Если ЗначениеЗаполнено(НомерПринятогоСтрока) Тогда
		НомерПринятогоСообщения = Число(НомерПринятогоСтрока);
	Иначе
		НомерПринятогоСообщения = 0;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПринятогоСообщения) Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, НомерПринятогоСообщения);
	КонецЕсли;	
	
	ОбъектыДляПередачи = ПолучитьСправочникиДляПередачи(Узел);
	
	НомерСообщения = НомерПринятогоСообщения + 1;
	
	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(Узел, НомерСообщения, ОбъектыДляПередачи.Ссылки);
	
	ИзмененныеОбъекты = Новый Массив;
	
	Пока ВыборкаИзменений.Следующий() Цикл
		
		Объект = ВыборкаИзменений.Получить();
		
		Если ТипЗнч(Объект) = Тип("СправочникОбъект.Аттракционы") Тогда
			ОписаниеОбъекта = ОписаниеАттракциона(Объект);
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникОбъект.Материалы") Тогда
			ОписаниеОбъекта = ОписаниеМатериала(Объект);
		ИначеЕсли ТипЗнч(Объект) = Тип("СправочникОбъект.ВидыРаботОбслуживанияАттакционов") Тогда
			ОписаниеОбъекта = ОписаниеВидаРаботОбслуживанияАттракциона(Объект);
		КонецЕсли;
		
		ИзмененныеОбъекты.Добавить(ОписаниеОбъекта);
		
	КонецЦикла;
	
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("ИзмененныеОбъекты", ИзмененныеОбъекты);
	ДанныеОтвета.Вставить("ЕстьЕщеДанные", ОбъектыДляПередачи.ЕстьЕщеДанные);
	
	ТелоОтвета = ЗаписатьЗначениеJSON(ДанныеОтвета);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Возврат Ответ;
	
КонецФункции

// Возвращает порцию зарегистрированных на узле плана обмена ОбменРемонтАттракционов документов ЗаказНаряд.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос HTTP-сервиса.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ, содержащий массив описаний измененных документов и признак наличия данных.
//
Функция ПолучитьЗаказНаряды(Запрос) Экспорт

	Узел = ИдентифицироватьМобильноеУстройство(Запрос);

	НомерПринятогоСтрока = Запрос.Заголовки.Получить("x-last-message");
	Если ЗначениеЗаполнено(НомерПринятогоСтрока) Тогда
		НомерПринятогоСообщения = Число(НомерПринятогоСтрока);
	Иначе
		НомерПринятогоСообщения = 0;
	КонецЕсли;

	Если ЗначениеЗаполнено(НомерПринятогоСообщения) Тогда
		ПланыОбмена.УдалитьРегистрациюИзменений(Узел, НомерПринятогоСообщения);
	КонецЕсли;

	ОбъектыДляПередачи = ПолучитьЗаказНарядыДляПередачи(Узел);

	НомерСообщения = НомерПринятогоСообщения + 1;

	ВыборкаИзменений = ПланыОбмена.ВыбратьИзменения(Узел, НомерСообщения, ОбъектыДляПередачи.Ссылки);

	ИзмененныеОбъекты = Новый Массив;

	Пока ВыборкаИзменений.Следующий() Цикл

		Объект = ВыборкаИзменений.Получить();

		Если ТипЗнч(Объект) = Тип("ДокументОбъект.ЗаказНаряд") Тогда
			ИзмененныеОбъекты.Добавить(ОписаниеЗаказНаряда(Объект));
		КонецЕсли;

	КонецЦикла;

	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("ИзмененныеОбъекты", ИзмененныеОбъекты);
	ДанныеОтвета.Вставить("ЕстьЕщеДанные", ОбъектыДляПередачи.ЕстьЕщеДанные);

	ТелоОтвета = ЗаписатьЗначениеJSON(ДанныеОтвета);

	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(ТелоОтвета);
	Ответ.Заголовки.Вставить("Content-Type", "application/json");

	Возврат Ответ;

КонецФункции

// Прикрепляет файл, переданный мобильным приложением в теле составного HTTP-сообщения
// (multipart/form-data), к документу ЗаказНаряд.
//
// Параметры:
//  Запрос - HTTPСервисЗапрос - запрос HTTP-сервиса. Содержимое файла передается в теле запроса,
//           идентификатор заказ-наряда - в параметре URL OrderOutfitId.
//
// Возвращаемое значение:
//  HTTPСервисОтвет - ответ, содержащий описание созданного присоединенного файла.
//
Функция ДобавитьФайл(Запрос) Экспорт
	
	ТелоЗапроса = Запрос.ПолучитьТелоКакДвоичныеДанные();
	ТипСодержимого = Запрос.Заголовки.Получить("Content-Type");
	Граница = РаботаСMultipartДанными.ГраницаИзТипаСодержимого(ТипСодержимого);
	
	Части = РаботаСMultipartДанными.Разобрать(ТелоЗапроса, Граница);
	ЧастьФайла = НайтиЧастьСФайлом(Части);
	
	Если ЧастьФайла = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'В теле запроса не передано содержимое файла.'");
	КонецЕсли;
	
	ЗаказНаряд = ЗаказНарядПоИдентификатору(Запрос.ПараметрыURL.Получить("OrderOutfitId"));
	
	ПрисоединенныйФайл = ПрикрепитьФайл(ЗаказНаряд, ЧастьФайла);
	
	ДанныеОтвета = Новый Структура;
	ДанныеОтвета.Вставить("Идентификатор", Строка(ПрисоединенныйФайл.УникальныйИдентификатор()));
	ДанныеОтвета.Вставить("ИмяФайла", ЧастьФайла.ИмяФайла);
	ДанныеОтвета.Вставить("ТипСодержимого", ЧастьФайла.ТипСодержимого);
	
	Ответ = Новый HTTPСервисОтвет(200);
	Ответ.УстановитьТелоИзСтроки(ЗаписатьЗначениеJSON(ДанныеОтвета));
	Ответ.Заголовки.Вставить("Content-Type", "application/json");
	
	Возврат Ответ;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ОписаниеАттракциона(Объект)
	
	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("Код", Объект.Код);
	Результат.Вставить("Наименование", Объект.Наименование);
	Результат.Вставить("Недействителен", Объект.Недействителен);
	Результат.Вставить("Тип", "Аттракционы");
	
	Возврат Результат;
	
КонецФункции

