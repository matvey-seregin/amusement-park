КонецФункции

Функция ОписаниеЗаказНаряда(Объект)

	Результат = Новый Структура;
	Результат.Вставить("Идентификатор", Строка(Объект.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("Тип", "ЗаказНаряд");
	Результат.Вставить("Номер", Объект.Номер);
	Результат.Вставить("Дата", ЗаписатьДатуJSON(Объект.Дата, ФорматДатыJSON.ISO, ВариантЗаписиДатыJSON.ЛокальнаяДата));
	Результат.Вставить("Аттракцион", ИдентификаторСсылки(Объект.Аттракцион));
	Результат.Вставить("Исполнитель", ИдентификаторСсылки(Объект.Исполнитель));
	Результат.Вставить("Статус", XMLСтрока(Объект.Статус));
	Результат.Вставить("Комментарий", Объект.Комментарий);
	Результат.Вставить("Работы", ОписаниеРаботЗаказНаряда(Объект.Работы));
	Результат.Вставить("Материалы", ОписаниеМатериаловЗаказНаряда(Объект.Материалы));

	Возврат Результат;

КонецФункции

Функция ОписаниеРаботЗаказНаряда(Работы)

	Результат = Новый Массив;

	Для Каждого СтрокаРаботы Из Работы Цикл
		ОписаниеРаботы = Новый Структура;
		ОписаниеРаботы.Вставить("ВидРаботы", ИдентификаторСсылки(СтрокаРаботы.ВидРаботы));
		ОписаниеРаботы.Вставить("Время", СтрокаРаботы.Время);
		Результат.Добавить(ОписаниеРаботы);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ОписаниеМатериаловЗаказНаряда(Материалы)

	Результат = Новый Массив;

	Для Каждого СтрокаМатериала Из Материалы Цикл
		ОписаниеМатериала = Новый Структура;
		ОписаниеМатериала.Вставить("Материал", ИдентификаторСсылки(СтрокаМатериала.Материал));
		ОписаниеМатериала.Вставить("Количество", СтрокаМатериала.Количество);
		Результат.Добавить(ОписаниеМатериала);
	КонецЦикла;

	Возврат Результат;

КонецФункции

Функция ИдентификаторСсылки(Ссылка)

	Если ЗначениеЗаполнено(Ссылка) Тогда
		Возврат Строка(Ссылка.УникальныйИдентификатор());
	КонецЕсли;

	Возврат "";

КонецФункции

Функция ИдентифицироватьМобильноеУстройство(Запрос)
	
	ИдентификаторКлиента = Запрос.Заголовки.Получить("x-client-id");
	ОСКлиента = Запрос.Заголовки.Получить("x-client-os");
	Пользователь = Пользователи.ТекущийПользователь();
	
	Результат = ПланыОбмена.ОбменРемонтАттракционов.НайтиПоКоду(ИдентификаторКлиента);
	
	Если Результат.Пустая() Тогда
		УзелОбъект = ПланыОбмена.ОбменРемонтАттракционов.СоздатьУзел();
		УзелОбъект.Код = ИдентификаторКлиента;
		УзелОбъект.Наименование = ОСКлиента;
		УзелОбъект.Пользователь = Пользователь;
		УзелОбъект.Записать();
		Результат = УзелОбъект.Ссылка;
		ВыполнитьНачальнуюРегистрацию(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

Процедура ВыполнитьНачальнуюРегистрацию(Узел)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Аттракционы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Аттракционы КАК Аттракционы
		|ГДЕ
		|	НЕ Аттракционы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ВидыРаботОбслуживанияАттакционов.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.ВидыРаботОбслуживанияАттакционов КАК ВидыРаботОбслуживанияАттакционов
		|ГДЕ
		|	НЕ ВидыРаботОбслуживанияАттакционов.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Материалы.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Материалы КАК Материалы
		|ГДЕ
		|	НЕ Материалы.ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.Исполнитель = &Исполнитель
		|	И НЕ ЗаказНаряд.ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Исполнитель", Пользователи.ТекущийПользователь());
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СсылкиДляРегистрации = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		СсылкиДляРегистрации.Добавить(Выборка.Ссылка);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(СсылкиДляРегистрации) Тогда
		ПланыОбмена.ЗарегистрироватьИзменения(Узел, СсылкиДляРегистрации);
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьЗаказНарядыДляПередачи(Узел)

	Результат = Новый Структура;
	Результат.Вставить("ЕстьЕщеДанные", Ложь);
	Результат.Вставить("Ссылки", Новый Массив);

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 101
		|	ЗаказНарядИзменения.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.ЗаказНаряд.Изменения КАК ЗаказНарядИзменения
		|ГДЕ
		|	ЗаказНарядИзменения.Узел = &Узел
		|
		|УПОРЯДОЧИТЬ ПО
		|	Ссылка";

	Запрос.УстановитьПараметр("Узел", Узел);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Количество() > 100 Тогда
		Результат.ЕстьЕщеДанные = Истина;
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
		Результат.Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Если Результат.ЕстьЕщеДанные Тогда
		Результат.Ссылки.Удалить(100);
	КонецЕсли;

	Возврат Результат;

КонецФункции

Функция ПолучитьСправочникиДляПередачи(Узел)
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьЕщеДанные", Ложь);
	Результат.Вставить("Ссылки", Новый Массив);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 101
		|	Т.Ссылка КАК Ссылка
		|ИЗ
		|	(ВЫБРАТЬ
		|		АттракционыИзменения.Ссылка КАК Ссылка
		|	ИЗ
		|		Справочник.Аттракционы.Изменения КАК АттракционыИзменения
		|	ГДЕ
		|		АттракционыИзменения.Узел = &Узел
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		ВидыРаботОбслуживанияАттакционовИзменения.Ссылка КАК Ссылка
		|	ИЗ
		|		Справочник.ВидыРаботОбслуживанияАттакционов.Изменения КАК ВидыРаботОбслуживанияАттакционовИзменения
		|	ГДЕ
		|		ВидыРаботОбслуживанияАттакционовИзменения.Узел = &Узел
		|
		|	ОБЪЕДИНИТЬ ВСЕ
		|
		|	ВЫБРАТЬ
		|		МатериалыИзменения.Ссылка КАК Ссылка
		|	ИЗ
		|		Справочник.Материалы.Изменения КАК МатериалыИзменения
		|	ГДЕ
		|		МатериалыИзменения.Узел = &Узел) КАК Т";

	Запрос.УстановитьПараметр("Узел", Узел);

	Выборка = Запрос.Выполнить().Выбрать();

	Если Выборка.Количество() > 100 Тогда
		Результат.ЕстьЕщеДанные = Истина;
	КонецЕсли;

	Пока Выборка.Следующий() Цикл
		Результат.Ссылки.Добавить(Выборка.Ссылка);
	КонецЦикла;

	Если Результат.ЕстьЕщеДанные Тогда
		Результат.Ссылки.Удалить(100);
	КонецЕсли;

	Возврат Результат;

КонецФункции

// Возвращает первую часть составного сообщения, содержащую файл.
//
// Параметры:
//  Части - Массив из Структура - части, полученные методом РаботаСMultipartДанными.Разобрать.
//
// Возвращаемое значение:
//  Структура - часть с файлом. Неопределено, если файл не передан.
//
Функция НайтиЧастьСФайлом(Части)
	
	Для Каждого Часть Из Части Цикл
		
		Если ЗначениеЗаполнено(Часть.ИмяФайла) Тогда
			Возврат Часть;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции

// Возвращает заказ-наряд по его уникальному идентификатору с проверкой прав текущего пользователя.
//
// Параметры:
//  Идентификатор - Строка - уникальный идентификатор заказ-наряда в формате UUID.
//
// Возвращаемое значение:
//  ДокументСсылка.ЗаказНаряд - найденный заказ-наряд.
//
Функция ЗаказНарядПоИдентификатору(Идентификатор)
	
	Если Не ЗначениеЗаполнено(Идентификатор) Тогда
		ВызватьИсключение НСтр("ru = 'Не указан идентификатор заказ-наряда.'");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЗаказНаряд.Ссылка КАК Ссылка,
		|	ЗаказНаряд.Исполнитель КАК Исполнитель
		|ИЗ
		|	Документ.ЗаказНаряд КАК ЗаказНаряд
		|ГДЕ
		|	ЗаказНаряд.Ссылка = &Ссылка
		|	И НЕ ЗаказНаряд.ПометкаУдаления";
	Запрос.УстановитьПараметр("Ссылка",
		Документы.ЗаказНаряд.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор)));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Не Выборка.Следующий() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Заказ-наряд с идентификатором %1 не найден.'"), Идентификатор);
	КонецЕсли;
	
	Если Выборка.Исполнитель <> Пользователи.ТекущийПользователь() Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Заказ-наряд %1 назначен другому исполнителю.'"), Идентификатор);
	КонецЕсли;
	
	Возврат Выборка.Ссылка;
	
КонецФункции

// Создает присоединенный файл владельца по данным переданной части составного сообщения.
//
// Параметры:
//  ЗаказНаряд - ДокументСсылка.ЗаказНаряд - владелец файла.
//  ЧастьФайла - Структура - часть составного сообщения с файлом, см. РаботаСMultipartДанными.Разобрать.
//
// Возвращаемое значение:
//  ОпределяемыйТип.ПрисоединенныйФайл - ссылка на созданный присоединенный файл.
//
Функция ПрикрепитьФайл(ЗаказНаряд, ЧастьФайла)
	
	ИмяБезРасширения = ЧастьФайла.ИмяФайла;
	РасширениеБезТочки = "";
	
	ЧастиИмени = СтрРазделить(ЧастьФайла.ИмяФайла, ".");
	Если ЧастиИмени.Количество() > 1 Тогда
		РасширениеБезТочки = ЧастиИмени[ЧастиИмени.Количество() - 1];
		ИмяБезРасширения = Лев(ЧастьФайла.ИмяФайла,
			СтрДлина(ЧастьФайла.ИмяФайла) - СтрДлина(РасширениеБезТочки) - 1);
	КонецЕсли;
	
	АдресДанныхФайла = ПоместитьВоВременноеХранилище(ЧастьФайла.Данные);
	
	ПараметрыДобавления = РаботаСФайлами.ПараметрыДобавленияФайла();
	ПараметрыДобавления.ВладелецФайлов = ЗаказНаряд;
	ПараметрыДобавления.ИмяБезРасширения = ИмяБезРасширения;
	ПараметрыДобавления.РасширениеБезТочки = РасширениеБезТочки;
	
	Возврат РаботаСФайлами.ДобавитьФайл(ПараметрыДобавления, АдресДанныхФайла);
	
КонецФункции

#КонецОбласти

	
	
	