#Область ПрограммныйИнтерфейс

// Извлекает значение атрибута boundary из заголовка Content-Type составного HTTP-сообщения.
//
// Параметры:
//  ТипСодержимого - Строка - значение заголовка Content-Type, например
//                   "multipart/form-data; boundary=----WebKitFormBoundary1a2b3c".
//
// Возвращаемое значение:
//  Строка - значение boundary без обрамляющих кавычек. Пустая строка, если атрибут не найден.
//
Функция ГраницаИзТипаСодержимого(ТипСодержимого) Экспорт
	
	Если Не ЗначениеЗаполнено(ТипСодержимого) Тогда
		Возврат "";
	КонецЕсли;
	
	Позиция = СтрНайти(ВРег(ТипСодержимого), "BOUNDARY=");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Граница = СокрЛП(Сред(ТипСодержимого, Позиция + СтрДлина("boundary=")));
	
	Позиция = СтрНайти(Граница, ";");
	Если Позиция > 0 Тогда
		Граница = СокрЛП(Лев(Граница, Позиция - 1));
	КонецЕсли;
	
	Если Лев(Граница, 1) = """" И Прав(Граница, 1) = """" И СтрДлина(Граница) > 1 Тогда
		Граница = Сред(Граница, 2, СтрДлина(Граница) - 2);
	КонецЕсли;
	
	Возврат Граница;
	
КонецФункции

// Разбирает тело составного HTTP-сообщения формата multipart/form-data на отдельные части.
//
// Параметры:
//  ТелоСообщения - ДвоичныеДанные - тело HTTP-запроса.
//  Граница       - Строка - значение атрибута boundary из заголовка Content-Type.
//
// Возвращаемое значение:
//  Массив из Структура:
//   * Имя            - Строка - значение атрибута name заголовка Content-Disposition.
//   * ИмяФайла       - Строка - значение атрибута filename заголовка Content-Disposition.
//   * ТипСодержимого - Строка - значение заголовка Content-Type части.
//   * Данные         - ДвоичныеДанные - содержимое части.
//
Функция Разобрать(ТелоСообщения, Граница) Экспорт
	
	Если Не ЗначениеЗаполнено(Граница) Тогда
		ВызватьИсключение НСтр("ru = 'Не заполнен атрибут boundary заголовка Content-Type.'");
	КонецЕсли;
	
	Разделитель = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзСтроки("--" + Граница, КодировкаТекста.UTF8));
	
	Чтение = Новый ЧтениеДанных(ТелоСообщения.ОткрытьПотокДляЧтения());
	
	Части = Новый Массив;
	
	Для Каждого ЧастьДанных Из Чтение.Разделить(Разделитель) Цикл
		
		Часть = РазобратьЧасть(ЧастьДанных.ПолучитьДвоичныеДанные());
		
		Если ЗначениеЗаполнено(Часть.Имя) Тогда
			Части.Добавить(Часть);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Части;
	
КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Выделяет из части заголовки и содержимое, разбирает заголовки Content-Disposition и Content-Type.
//
// Параметры:
//  ДанныеЧасти - ДвоичныеДанные - часть составного сообщения вместе с заголовками.
//
// Возвращаемое значение:
//  Структура - см. РаботаСMultipartДанными.Разобрать.
//
Функция РазобратьЧасть(ДанныеЧасти)
	
	Результат = Новый Структура;
	Результат.Вставить("Имя", "");
	Результат.Вставить("ИмяФайла", "");
	Результат.Вставить("ТипСодержимого", "");
	Результат.Вставить("Данные", Неопределено);
	
	Буфер = ПолучитьБуферДвоичныхДанныхИзДвоичныхДанных(ДанныеЧасти);
	ПозицияЗаголовков = ПозицияПустойСтроки(Буфер);
	
	Если ПозицияЗаголовков < 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Заголовки = ПолучитьСтрокуИзДвоичныхДанных(
		ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(Буфер.Прочитать(0, ПозицияЗаголовков)),
		КодировкаТекста.UTF8);
	
	ЗаполнитьРеквизитыЧасти(Заголовки, Результат);
	
	РазделительЗаголовков = Символы.ВК + Символы.ПС + Символы.ВК + Символы.ПС;
	НачалоСодержимого = ПозицияЗаголовков + СтрДлина(РазделительЗаголовков);
	КонецСодержимого = Буфер.Размер;
	
	// Завершающий перевод строки относится к разделителю частей, а не к содержимому.
	БайтВК = КодСимвола(Символы.ВК);
	БайтПС = КодСимвола(Символы.ПС);
	
	Пока КонецСодержимого > НачалоСодержимого Цикл
		
		Байт = Буфер.Получить(КонецСодержимого - 1);
		Если Байт <> БайтВК И Байт <> БайтПС Тогда
			Прервать;
		КонецЕсли;
		
		КонецСодержимого = КонецСодержимого - 1;
		
	КонецЦикла;
	
	Результат.Данные = ПолучитьДвоичныеДанныеИзБуфераДвоичныхДанных(
		Буфер.Прочитать(НачалоСодержимого, КонецСодержимого - НачалоСодержимого));
	
	Возврат Результат;
	
КонецФункции

// Ищет позицию пустой строки (последовательности CRLFCRLF), отделяющей заголовки части от содержимого.
//
// Параметры:
//  Буфер - БуферДвоичныхДанных - буфер с частью составного сообщения.
//
// Возвращаемое значение:
//  Число - позиция первого байта последовательности. -1, если последовательность не найдена.
//
Функция ПозицияПустойСтроки(Буфер)
	
	БайтВК = КодСимвола(Символы.ВК);
	БайтПС = КодСимвола(Символы.ПС);
	
	МаксимальнаяДлинаЗаголовков = 16384;
	КонецПоиска = Буфер.Размер;
	Если КонецПоиска > МаксимальнаяДлинаЗаголовков Тогда
		КонецПоиска = МаксимальнаяДлинаЗаголовков;
	КонецЕсли;
	
	Позиция = 0;
	Пока Позиция <= КонецПоиска - 4 Цикл
		
		Если Буфер.Получить(Позиция) = БайтВК
			И Буфер.Получить(Позиция + 1) = БайтПС
			И Буфер.Получить(Позиция + 2) = БайтВК
			И Буфер.Получить(Позиция + 3) = БайтПС Тогда
			
			Возврат Позиция;
			
		КонецЕсли;
		
		Позиция = Позиция + 1;
		
	КонецЦикла;
	
	Возврат -1;
	
КонецФункции

// Заполняет реквизиты части по тексту ее заголовков.
//
// Параметры:
//  Заголовки - Строка - текст заголовков части.
//  Результат - Структура - реквизиты части, заполняемые методом.
//
Процедура ЗаполнитьРеквизитыЧасти(Заголовки, Результат)
	
	Для Каждого СтрокаЗаголовка Из СтрРазделить(Заголовки, Символы.ВК + Символы.ПС) Цикл
		
		ПозицияДвоеточия = СтрНайти(СтрокаЗаголовка, ":");
		Если ПозицияДвоеточия = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяЗаголовка = ВРег(СокрЛП(Лев(СтрокаЗаголовка, ПозицияДвоеточия - 1)));
		ЗначениеЗаголовка = СокрЛП(Сред(СтрокаЗаголовка, ПозицияДвоеточия + 1));
		
		Если ИмяЗаголовка = "CONTENT-DISPOSITION" Тогда
			ЗаполнитьРеквизитыЗаголовкаРасположения(ЗначениеЗаголовка, Результат);
		КонецЕсли;
		
		Если ИмяЗаголовка = "CONTENT-TYPE" Тогда
			Результат.ТипСодержимого = ЗначениеЗаголовка;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет имя части и имя файла по значению заголовка Content-Disposition.
//
// Параметры:
//  ЗначениеЗаголовка - Строка - значение заголовка Content-Disposition.
//  Результат         - Структура - реквизиты части, заполняемые методом.
//
Процедура ЗаполнитьРеквизитыЗаголовкаРасположения(ЗначениеЗаголовка, Результат)
	
	Для Каждого Параметр Из СтрРазделить(ЗначениеЗаголовка, ";") Цикл
		
		Параметр = СокрЛП(Параметр);
		
		Если ЭтоАтрибутЗаголовка(Параметр, "name") Тогда
			Результат.Имя = ЗначениеПараметраЗаголовка(Параметр);
		КонецЕсли;
		
		Если ЭтоАтрибутЗаголовка(Параметр, "filename") Тогда
			Результат.ИмяФайла = ЗначениеПараметраЗаголовка(Параметр);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Проверяет, что параметр заголовка задает значение указанного атрибута.
//
// Параметры:
//  Параметр    - Строка - параметр заголовка, например "filename=""photo.jpg""".
//  ИмяАтрибута - Строка - имя атрибута заголовка, например "filename".
//
// Возвращаемое значение:
//  Булево - Истина, если параметр начинается с "<ИмяАтрибута>=".
//
Функция ЭтоАтрибутЗаголовка(Параметр, ИмяАтрибута)
	
	Маска = ИмяАтрибута + "=";
	Возврат ВРег(Лев(Параметр, СтрДлина(Маска))) = ВРег(Маска);
	
КонецФункции

// Извлекает значение параметра заголовка вида Имя="Значение".
//
// Параметры:
//  Параметр - Строка - параметр заголовка, например "filename=""photo.jpg""".
//
// Возвращаемое значение:
//  Строка - значение параметра без обрамляющих кавычек.
//
Функция ЗначениеПараметраЗаголовка(Параметр)
	
	Позиция = СтрНайти(Параметр, "=");
	Если Позиция = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Значение = СокрЛП(Сред(Параметр, Позиция + 1));
	
	Если Лев(Значение, 1) = """" И Прав(Значение, 1) = """" И СтрДлина(Значение) > 1 Тогда
		Значение = Сред(Значение, 2, СтрДлина(Значение) - 2);
	КонецЕсли;
	
	Возврат Значение;
	
КонецФункции

#КонецОбласти
