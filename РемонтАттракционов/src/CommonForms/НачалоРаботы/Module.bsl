
&НаСервере
Процедура СохранитьАдресЦентральнойБазы()
	
	Константы.АдресЦентральнойБазы.Установить(Адрес);

КонецПроцедуры

&НаКлиенте
Процедура НачатьРаботу(Команда)
	
	СохранитьАдресЦентральнойБазы();
	
	ПараметрыОбмена = ОбменКлиент.НовыеПараметрыОбмена();
	ПараметрыОбмена.Логин = Логин;
	ПараметрыОбмена.Пароль = Пароль;
	
	ОбменКлиент.ВыполнитьОбмен(ПараметрыОбмена);
	
КонецПроцедуры
