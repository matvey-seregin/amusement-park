
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Адрес = Константы.АдресЦентральнойБазы.Получить();
	Логин = Константы.ЛогинЦентральнойБазы.Получить();

КонецПроцедуры

&НаСервере
Процедура СохранитьПараметрыПодключения()
	
	Константы.АдресЦентральнойБазы.Установить(Адрес);
	Константы.ЛогинЦентральнойБазы.Установить(Логин);

КонецПроцедуры

&НаКлиенте
Процедура НачатьРаботу(Команда)
	
	СохранитьПараметрыПодключения();
	
	ПараметрыОбмена = ОбменКлиент.НовыеПараметрыОбмена();
	ПараметрыОбмена.Логин = Логин;
	ПараметрыОбмена.Пароль = Пароль;
	
	ОбменКлиент.ВыполнитьОбмен(ПараметрыОбмена);
	
	Закрыть();
	
КонецПроцедуры
