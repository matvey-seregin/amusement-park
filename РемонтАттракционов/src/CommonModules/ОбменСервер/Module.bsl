
#Область ПрограммныйИнтерфейс

// Выполнить обмен с центральной базой.
//
// Параметры:
//  ПараметрыОбмена - См. ОбменКлиент.НовыеПараметрыОбмена()
//
// Возвращаемое значение:
//  См. НовыйРезультатВыполненияОбмена
Функция ВыполнитьОбмен(ПараметрыОбмена) Экспорт
	
	Адрес = Константы.АдресЦентральнойБазы.Получить();
	
	Если Не ЗначениеЗаполнено(Адрес) Тогда		
		Возврат ПодготовитьОписаниеОшибки(
			ОбменКлиентСервер.КодОшибки_АдресНеЗадан(), 
			"Не заполнен адрес");
	КонецЕсли;
	
	КонтекстОбмена = НовыйКонтекстОбмена();
	ЗаполнитьЗначенияСвойств(КонтекстОбмена, ПараметрыОбмена);
	КонтекстОбмена.Адрес = Адрес;
	
	// 1. Получить данные для аутентификации
	ВыполнитьАутентификацию(КонтекстОбмена);
	
	Если КонтекстОбмена.ОшибкаОбмена Тогда
		Возврат ПодготовитьОписаниеОшибки(
			КонтекстОбмена.КодОшибки, 
			КонтекстОбмена.КраткийТекстОшибки);
	КонецЕсли;
	
	Если Не КонтекстОбмена.АутентификацияВыполнена Тогда
		Возврат ПодготовитьОписаниеОшибки(
			ОбменКлиентСервер.КодОшибки_АутентификацияНеВыполнена(),
			КонтекстОбмена.КраткийТекстОшибки);
	КонецЕсли;
	
	// 2. Проверить доступность центральной базы
	ПроверитьДоступность(КонтекстОбмена);
	
	Если КонтекстОбмена.ОшибкаОбмена Тогда
		Возврат ПодготовитьОписаниеОшибки(
			КонтекстОбмена.КодОшибки, 
			КонтекстОбмена.КраткийТекстОшибки);
	КонецЕсли;
	
	Если Не КонтекстОбмена.АутентификацияВыполнена Тогда
		Возврат ПодготовитьОписаниеОшибки(
			ОбменКлиентСервер.КодОшибки_АутентификацияНеВыполнена(),
			КонтекстОбмена.КраткийТекстОшибки);
	КонецЕсли;
	
	// 3. Выполнить обмен
	ВыполнитьОбменСлужебный(КонтекстОбмена);
	
	Если КонтекстОбмена.ОшибкаОбмена Тогда
		Возврат ПодготовитьОписаниеОшибки(
			КонтекстОбмена.КодОшибки, 
			КонтекстОбмена.КраткийТекстОшибки);
	КонецЕсли;
	
	Если Не КонтекстОбмена.АутентификацияВыполнена Тогда
		Возврат ПодготовитьОписаниеОшибки(
			ОбменКлиентСервер.КодОшибки_АутентификацияНеВыполнена(),
			КонтекстОбмена.КраткийТекстОшибки);
	КонецЕсли;

	Результат = НовыйРезультатВыполненияОбмена();
	Результат.Результат = КонтекстОбмена.Результат;
	
	Возврат Результат;

КонецФункции

// Новый результат выполнения обмена.
//
// Возвращаемое значение:
//  Структура - результат выполнения обмена:
// * Успешно - Булево - Истина, если обмен выполнен без ошибок
// * КодОшибки - Строка - Код ошибки, см. ОбменКлиентСервер
// * ТекстОшибки - Строка - Текст ошибки
// * Результат - Произвольный, Неопределено - Результат обмена
Функция НовыйРезультатВыполненияОбмена() Экспорт

	Результат = Новый Структура;
	Результат.Вставить("Успешно", Истина);
	Результат.Вставить("КодОшибки", "");
	Результат.Вставить("ТекстОшибки", "");
	Результат.Вставить("Результат", Неопределено);

	Возврат Результат;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ВыполнитьАутентификацию(КонтекстОбмена)
	
	Токен = Константы.ТокенЦентральнойБазы.Получить();
	
	Если ЗначениеЗаполнено(Токен) Тогда
		
		Если Не СрокДействияТокенаИстекает(Токен) Тогда
			
			КонтекстОбмена.Токен = Токен;
			КонтекстОбмена.АутентификацияВыполнена = Истина;
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ОписаниеТокена = ПолучитьОписаниеТокена(КонтекстОбмена);
	
	Если КонтекстОбмена.ОшибкаОбмена Тогда
		Возврат;
	КонецЕсли;
	
	Если ОписаниеТокена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КонтекстОбмена.АутентификацияВыполнена = Истина;
	
	Если ОписаниеТокена.ПоддерживаетсяТокенДоступа Тогда
		КонтекстОбмена.Токен = ОписаниеТокена.ТокенДоступа;
		Константы.ТокенЦентральнойБазы.Установить(ОписаниеТокена.ТокенДоступа);
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДоступность(КонтекстОбмена)
	
	СтруктураURI = ОбщегоНазначенияСервер.СтруктураURI(КонтекстОбмена.Адрес);
	
	Если Не ЗначениеЗаполнено(КонтекстОбмена.Токен) Тогда
		СтруктураURI.Логин = КонтекстОбмена.Логин;
		СтруктураURI.Пароль = КонтекстОбмена.Пароль;
	КонецЕсли;
	
	ПутьЗапроса = СтруктураURI.ПутьНаСервере + "/hs/mob-repair/ping";
	Если Лев(ПутьЗапроса, 1) <> "/" Тогда
		ПутьЗапроса = "/" + ПутьЗапроса;
	КонецЕсли;
	
	Попытка
		
		Соединение = ОбщегоНазначенияСервер.СоединениеHTTP(СтруктураURI);
		
		// Создание HTTP запроса с учетом относительного пути
		ЗапросHTTP = Новый HTTPЗапрос(ПутьЗапроса);
		
		Если ЗначениеЗаполнено(КонтекстОбмена.Токен) Тогда
			ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + КонтекстОбмена.Токен);
		КонецЕсли;
		
		// Выполнение GET запроса
		ОтветHTTP = Соединение.Получить(ЗапросHTTP);
		
		// Проверка кода состояния
		Если ОтветHTTP.КодСостояния = 401 Тогда
			КонтекстОбмена.АутентификацияВыполнена = Ложь;
		ИначеЕсли ОтветHTTP.КодСостояния <> 200 Тогда
			КонтекстОбмена.ОшибкаОбмена = Истина;
			ШаблонТекстаОшибки = 
				"Код состояния: %1
				|%2";
			КонтекстОбмена.ПодробныйТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, 
				ОтветHTTP.КодСостояния, 
				ОтветHTTP.ПолучитьТелоКакСтроку());
			КонтекстОбмена.КраткийТекстОшибки = КонтекстОбмена.ПодробныйТекстОшибки;
		КонецЕсли;
		
	Исключение
		КонтекстОбмена.ОшибкаОбмена = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонтекстОбмена.КодОшибки = ОбменКлиентСервер.КодОшибки_ОшибкаСоединения();
		КонтекстОбмена.ПодробныйТекстОшибки = 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		КонтекстОбмена.КраткийТекстОшибки = 
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецПопытки;
	
КонецПроцедуры

Процедура ВыполнитьОбменСлужебный(КонтекстОбмена)
	
	СтруктураURI = ОбщегоНазначенияСервер.СтруктураURI(КонтекстОбмена.Адрес);
	
	Если Не ЗначениеЗаполнено(КонтекстОбмена.Токен) Тогда
		СтруктураURI.Логин = КонтекстОбмена.Логин;
		СтруктураURI.Пароль = КонтекстОбмена.Пароль;
	КонецЕсли;
	
	КонтекстОбмена.НомерПринятогоСообщения = Константы.НомерПринятогоСообщения.Получить();
	ВсегоЗагружено = 0;
	
	Попытка
		
		Соединение = ОбщегоНазначенияСервер.СоединениеHTTP(СтруктураURI);
		
		// Номер принятого сообщения общий для всех ресурсов сервиса, поэтому ресурсы
		// обходятся последовательно: сначала справочники, затем документы.
		ВсегоЗагружено = ВсегоЗагружено + ВыполнитьОбменПоРесурсу(
			КонтекстОбмена, Соединение, СтруктураURI, "catalogs");
		
		Если Не КонтекстОбмена.ОшибкаОбмена И КонтекстОбмена.АутентификацияВыполнена Тогда
			ВсегоЗагружено = ВсегоЗагружено + ВыполнитьОбменПоРесурсу(
				КонтекстОбмена, Соединение, СтруктураURI, "order-outfits");
		КонецЕсли;
		
		Если Не КонтекстОбмена.ОшибкаОбмена Тогда
			КонтекстОбмена.Результат = СтрШаблон("Загружено объектов: %1", ВсегоЗагружено);
		КонецЕсли;
		
	Исключение
		КонтекстОбмена.ОшибкаОбмена = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонтекстОбмена.КодОшибки = ОбменКлиентСервер.КодОшибки_ОшибкаСоединения();
		КонтекстОбмена.ПодробныйТекстОшибки = 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		КонтекстОбмена.КраткийТекстОшибки = 
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецПопытки;
	
КонецПроцедуры

// Выполняет выгрузку одного ресурса HTTP-сервиса порциями.
//
// Параметры:
//  КонтекстОбмена - Структура - см. НовыйКонтекстОбмена().
//  Соединение - HTTPСоединение - соединение с центральной базой.
//  СтруктураURI - Структура - см. ОбщегоНазначенияСервер.СтруктураURI().
//  ИмяРесурса - Строка - имя ресурса HTTP-сервиса, например "catalogs".
//
// Возвращаемое значение:
//  Число - количество загруженных объектов.
//
Функция ВыполнитьОбменПоРесурсу(КонтекстОбмена, Соединение, СтруктураURI, ИмяРесурса)
	
	ВсегоЗагружено = 0;
	
	Пока Истина Цикл
		
		ДанныеОтвета = ЗапроситьПорциюИзменений(КонтекстОбмена, Соединение, СтруктураURI, ИмяРесурса);
		
		Если ДанныеОтвета = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Попытка
			ЗаписатьИзмененияПоОтвету(ДанныеОтвета.ИзмененныеОбъекты);
			ВсегоЗагружено = ВсегоЗагружено + ДанныеОтвета.ИзмененныеОбъекты.Количество();
		Исключение
			КонтекстОбмена.ОшибкаОбмена = Истина;
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			КонтекстОбмена.КодОшибки = ОбменКлиентСервер.КодОшибки_ОшибкаЗаписиДанных();
			КонтекстОбмена.ПодробныйТекстОшибки = 
				ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
			КонтекстОбмена.КраткийТекстОшибки = 
				ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			Прервать;
		КонецПопытки;
		
		// Номер принятого сообщения подтверждается только после успешной записи порции,
		// иначе не записанные данные пришлось бы запрашивать повторно.
		КонтекстОбмена.НомерПринятогоСообщения = КонтекстОбмена.НомерПринятогоСообщения + 1;
		Константы.НомерПринятогоСообщения.Установить(КонтекстОбмена.НомерПринятогоСообщения);
		
		Если Не ДанныеОтвета.ЕстьЕщеДанные Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ВсегоЗагружено;
	
КонецФункции

// Запрашивает у HTTP-сервиса очередную порцию изменений.
//
// Параметры:
//  КонтекстОбмена - Структура - см. НовыйКонтекстОбмена().
//  Соединение - HTTPСоединение - соединение с центральной базой.
//  СтруктураURI - Структура - см. ОбщегоНазначенияСервер.СтруктураURI().
//  ИмяРесурса - Строка - имя ресурса HTTP-сервиса, например "catalogs".
//
// Возвращаемое значение:
//  Структура, Неопределено - описание ответа сервиса или Неопределено, если запрос не выполнен.
//
Функция ЗапроситьПорциюИзменений(КонтекстОбмена, Соединение, СтруктураURI, ИмяРесурса)
	
	ПутьЗапроса = СтруктураURI.ПутьНаСервере + "/hs/mob-repair/" + ИмяРесурса;
	Если Лев(ПутьЗапроса, 1) <> "/" Тогда
		ПутьЗапроса = "/" + ПутьЗапроса;
	КонецЕсли;
	
	СистемнаяИнформация = Новый СистемнаяИнформация();
	
	// Создание HTTP запроса с учетом относительного пути
	ЗапросHTTP = Новый HTTPЗапрос(ПутьЗапроса);
	ЗапросHTTP.Заголовки.Вставить("x-last-message", Строка(КонтекстОбмена.НомерПринятогоСообщения));
	ЗапросHTTP.Заголовки.Вставить("x-client-id", Строка(СистемнаяИнформация.ИдентификаторКлиента));
	ЗапросHTTP.Заголовки.Вставить("x-client-os", СистемнаяИнформация.ВерсияОС);
	
	Если ЗначениеЗаполнено(КонтекстОбмена.Токен) Тогда
		ЗапросHTTP.Заголовки.Вставить("Authorization", "Bearer " + КонтекстОбмена.Токен);
	КонецЕсли;
	
	// Выполнение GET запроса
	ОтветHTTP = Соединение.Получить(ЗапросHTTP);
	
	// Проверка кода состояния
	Если ОтветHTTP.КодСостояния = 401 Тогда
		КонтекстОбмена.АутентификацияВыполнена = Ложь;
		Возврат Неопределено;
	ИначеЕсли ОтветHTTP.КодСостояния <> 200 Тогда
		КонтекстОбмена.ОшибкаОбмена = Истина;
		ШаблонТекстаОшибки = 
			"Код состояния: %1
			|%2";
		КонтекстОбмена.ПодробныйТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, 
			ОтветHTTP.КодСостояния, 
			ОтветHTTP.ПолучитьТелоКакСтроку());
		КонтекстОбмена.КраткийТекстОшибки = КонтекстОбмена.ПодробныйТекстОшибки;
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат ПрочитатьЗначениеJSON(ОтветHTTP.ПолучитьТелоКакСтроку());
	Исключение
		КонтекстОбмена.ОшибкаОбмена = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонтекстОбмена.КодОшибки = ОбменКлиентСервер.КодОшибки_ОшибкаРазбораОтвета();
		КонтекстОбмена.ПодробныйТекстОшибки = 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		КонтекстОбмена.КраткийТекстОшибки = 
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции

// Записывает в информационную базу объекты, полученные от сервиса.
//
// Параметры:
//  ИзмененныеОбъекты - Массив из Структура - описания объектов, полученные от сервиса.
//
Процедура ЗаписатьИзмененияПоОтвету(ИзмененныеОбъекты)
	
	Для Каждого ОписаниеОбъекта Из ИзмененныеОбъекты Цикл
		
		Если ОписаниеОбъекта.Тип = "Аттракционы" Тогда
			ЗаполнитьЭлементСправочника(Справочники.Аттракционы, ОписаниеОбъекта);
		ИначеЕсли ОписаниеОбъекта.Тип = "Материалы" Тогда
			ЗаполнитьЭлементСправочника(Справочники.Материалы, ОписаниеОбъекта);
		ИначеЕсли ОписаниеОбъекта.Тип = "ВидыРаботОбслуживанияАттакционов" Тогда
			ЗаполнитьЭлементСправочника(Справочники.ВидыРаботОбслуживанияАттакционов, ОписаниеОбъекта);
		ИначеЕсли ОписаниеОбъекта.Тип = "ЗаказНаряд" Тогда
			ЗаполнитьЗаказНарядПоОписанию(ОписаниеОбъекта);
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет документ ЗаказНаряд данными объекта, полученными от сервиса.
//
// Параметры:
//  ОписаниеОбъекта - Структура - описание документа: Идентификатор, Номер, Дата, Аттракцион,
//                    Статус, Комментарий, Работы, Материалы.
//
Процедура ЗаполнитьЗаказНарядПоОписанию(ОписаниеОбъекта)
	
	Ссылка = Документы.ЗаказНаряд.ПолучитьСсылку(
		Новый УникальныйИдентификатор(ОписаниеОбъекта.Идентификатор));
	
	Объект = Ссылка.ПолучитьОбъект();
	
	Если Объект = Неопределено Тогда
		Объект = Документы.ЗаказНаряд.СоздатьДокумент();
		Объект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	Объект.Номер = ОписаниеОбъекта.Номер;
	Объект.Дата = ПрочитатьДатуJSON(ОписаниеОбъекта.Дата, ФорматДатыJSON.ISO);
	Объект.Аттракцион = СсылкаПоИдентификатору(Справочники.Аттракционы, ОписаниеОбъекта.Аттракцион);
	Объект.Комментарий = ОписаниеОбъекта.Комментарий;
	
	Если ЗначениеЗаполнено(ОписаниеОбъекта.Статус) Тогда
		Объект.Статус = XMLЗначение(Тип("ПеречислениеСсылка.СтатусыВыполненияРабот"), ОписаниеОбъекта.Статус);
	КонецЕсли;
	
	ЗаполнитьРаботыЗаказНаряда(Объект.Работы, ОписаниеОбъекта.Работы);
	ЗаполнитьМатериалыЗаказНаряда(Объект.Материалы, ОписаниеОбъекта.Материалы);
	
	Объект.Записать();
	
КонецПроцедуры

// Заполняет табличную часть Работы документа ЗаказНаряд.
//
// Параметры:
//  Работы - ТабличнаяЧасть - заполняемая табличная часть документа ЗаказНаряд.
//  ОписаниеРабот - Массив из Структура - описания работ: ВидРаботы, Время.
//
Процедура ЗаполнитьРаботыЗаказНаряда(Работы, ОписаниеРабот)
	
	Работы.Очистить();
	
	Для Каждого ОписаниеРаботы Из ОписаниеРабот Цикл
		
		СтрокаРаботы = Работы.Добавить();
		СтрокаРаботы.ВидРаботы = СсылкаПоИдентификатору(
			Справочники.ВидыРаботОбслуживанияАттакционов, ОписаниеРаботы.ВидРаботы);
		СтрокаРаботы.Время = ОписаниеРаботы.Время;
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет табличную часть Материалы документа ЗаказНаряд.
//
// Параметры:
//  Материалы - ТабличнаяЧасть - заполняемая табличная часть документа ЗаказНаряд.
//  ОписаниеМатериалов - Массив из Структура - описания материалов: Материал, Количество.
//
Процедура ЗаполнитьМатериалыЗаказНаряда(Материалы, ОписаниеМатериалов)
	
	Материалы.Очистить();
	
	Для Каждого ОписаниеМатериала Из ОписаниеМатериалов Цикл
		
		СтрокаМатериала = Материалы.Добавить();
		СтрокаМатериала.Материал = СсылкаПоИдентификатору(
			Справочники.Материалы, ОписаниеМатериала.Материал);
		СтрокаМатериала.Количество = ОписаниеМатериала.Количество;
		
	КонецЦикла;
	
КонецПроцедуры

// Возвращает ссылку на объект по его уникальному идентификатору.
//
// Параметры:
//  МенеджерОбъекта - СправочникМенеджер - менеджер справочника, которому принадлежит объект.
//  Идентификатор - Строка - уникальный идентификатор объекта, полученный от сервиса.
//
// Возвращаемое значение:
//  СправочникСсылка - ссылка на объект или пустая ссылка, если идентификатор не заполнен.
//
Функция СсылкаПоИдентификатору(МенеджерОбъекта, Идентификатор)
	
	Если ПустаяСтрока(Идентификатор) Тогда
		Возврат МенеджерОбъекта.ПустаяСсылка();
	КонецЕсли;
	
	Возврат МенеджерОбъекта.ПолучитьСсылку(Новый УникальныйИдентификатор(Идентификатор));
	
КонецФункции

// Заполняет элемент справочника данными объекта, полученными от сервиса.
//
// Параметры:
//  МенеджерСправочника - СправочникМенеджер - менеджер заполняемого справочника.
//  ОписаниеОбъекта - Структура - описание объекта: Идентификатор, Код, Наименование, Недействителен.
//
Процедура ЗаполнитьЭлементСправочника(МенеджерСправочника, ОписаниеОбъекта)
	
	Идентификатор = Новый УникальныйИдентификатор(ОписаниеОбъекта.Идентификатор);
	
	Ссылка = МенеджерСправочника.ПолучитьСсылку(Идентификатор);
	
	Объект = Ссылка.ПолучитьОбъект();
	
	Если Объект = Неопределено Тогда
		Объект = МенеджерСправочника.СоздатьЭлемент();
		Объект.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	ЗаполнитьЗначенияСвойств(Объект, ОписаниеОбъекта);
	
	Объект.Записать();
	
КонецПроцедуры

Функция ПолучитьОписаниеТокена(КонтекстОбмена)
	
	СтруктураURI = ОбщегоНазначенияСервер.СтруктураURI(КонтекстОбмена.Адрес);
	
	СтруктураURI.Логин = КонтекстОбмена.Логин;
	СтруктураURI.Пароль = КонтекстОбмена.Пароль;
	
	ПутьЗапроса = СтруктураURI.ПутьНаСервере + "/hs/mob-repair/token";
	Если Лев(ПутьЗапроса, 1) <> "/" Тогда
		ПутьЗапроса = "/" + ПутьЗапроса;
	КонецЕсли;
	
	Попытка
		
		Соединение = ОбщегоНазначенияСервер.СоединениеHTTP(СтруктураURI);
		
		ЗапросHTTP = Новый HTTPЗапрос(ПутьЗапроса);
		
		ОтветHTTP = Соединение.Получить(ЗапросHTTP);
		
		Если ОтветHTTP.КодСостояния = 200 Тогда
			Попытка
				Возврат ПрочитатьЗначениеJSON(ОтветHTTP.ПолучитьТелоКакСтроку());
			Исключение
				КонтекстОбмена.ОшибкаОбмена = Истина;
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				КонтекстОбмена.КодОшибки = ОбменКлиентСервер.КодОшибки_ОшибкаРазбораОтвета();
				КонтекстОбмена.ПодробныйТекстОшибки = 
					ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
				КонтекстОбмена.КраткийТекстОшибки = 
					ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
			КонецПопытки;
		ИначеЕсли ОтветHTTP.КодСостояния = 401 Тогда
			КонтекстОбмена.АутентификацияВыполнена = Ложь;
		Иначе
			КонтекстОбмена.ОшибкаОбмена = Истина;
			ШаблонТекстаОшибки = 
				"Код состояния: %1
				|%2";
			КонтекстОбмена.ПодробныйТекстОшибки = СтрШаблон(ШаблонТекстаОшибки, 
				ОтветHTTP.КодСостояния, 
				ОтветHTTP.ПолучитьТелоКакСтроку());
			КонтекстОбмена.КраткийТекстОшибки = КонтекстОбмена.ПодробныйТекстОшибки;
		КонецЕсли;
		
	Исключение
		КонтекстОбмена.ОшибкаОбмена = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		КонтекстОбмена.КодОшибки = ОбменКлиентСервер.КодОшибки_ОшибкаСоединения();
		КонтекстОбмена.ПодробныйТекстОшибки = 
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке);
		КонтекстОбмена.КраткийТекстОшибки = 
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецПопытки;
	
	Возврат Неопределено;	
	
КонецФункции

Функция НовыйКонтекстОбмена()
	
	Результат = Новый Структура;
	Результат.Вставить("Адрес", "");
	Результат.Вставить("Логин", "");
	Результат.Вставить("Пароль", "");
	Результат.Вставить("Токен", "");
	Результат.Вставить("НомерПринятогоСообщения", 0);
	Результат.Вставить("АутентификацияВыполнена", Ложь);
	Результат.Вставить("ОшибкаОбмена", Ложь);
	Результат.Вставить("КодОшибки");
	Результат.Вставить("КраткийТекстОшибки");
	Результат.Вставить("ПодробныйТекстОшибки");
	Результат.Вставить("Результат");
	
	Возврат Результат;	
	
КонецФункции

Функция ПодготовитьОписаниеОшибки(КодОшибки, ТекстОшибки)
	
	Результат = НовыйРезультатВыполненияОбмена();
	Результат.Успешно = Ложь;
	Результат.КодОшибки = КодОшибки;
	Результат.ТекстОшибки = ТекстОшибки;
	
	Возврат Результат;
	
КонецФункции

// Проверяет, истёк ли срок действия JWT-токена или истекает в ближайший час.
//
// Параметры:
//  Токен - Строка - JWT-токен, из которого читается время истечения (claim "exp").
//
// Возвращаемое значение:
//  Булево - Истина, если срок действия токена истёк, истекает в течение ближайшего часа
//           либо токен не удалось разобрать.
//
Функция СрокДействияТокенаИстекает(Токен)
	
	ЧастиТокена = СтрРазделить(Токен, ".");
	
	Если ЧастиТокена.Количество() <> 3 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Попытка
		ДанныеТокена = ПрочитатьЗначениеJSON(ДекодироватьBase64URL(ЧастиТокена[1]));
	Исключение
		Возврат Истина;
	КонецПопытки;
	
	Если ТипЗнч(ДанныеТокена) <> Тип("Структура")
		Или Не ДанныеТокена.Свойство("exp")
		Или ТипЗнч(ДанныеТокена.exp) <> Тип("Число") Тогда
		Возврат Истина;
	КонецЕсли;
	
	// 62135596800 - число секунд с 01.01.0001 (начало отсчёта дат 1С) до 01.01.1970 (начало Unix-эпохи).
	// Вычитание переводит секунды, прошедшие с начала отсчёта 1С, в Unix-секунды (claim "exp").
	ТекущееВремяUnix = ТекущаяУниверсальнаяДатаВМиллисекундах() / 1000 - 62135596800;
	
	Возврат ДанныеТокена.exp <= ТекущееВремяUnix + 3600;
	
КонецФункции

// Декодирует значение из формата Base64URL (RFC 4648) в строку UTF-8.
//
// Параметры:
//  Значение - Строка - значение, закодированное в Base64URL.
//
// Возвращаемое значение:
//  Строка - декодированная строка.
//
Функция ДекодироватьBase64URL(Значение)
	
	СтрокаBase64 = СтрЗаменить(Значение, "-", "+");
	СтрокаBase64 = СтрЗаменить(СтрокаBase64, "_", "/");
	
	Остаток = СтрДлина(СтрокаBase64) % 4;
	Если Остаток <> 0 Тогда
		СтрокаBase64 = СтрокаBase64 + Лев("====", 4 - Остаток);
	КонецЕсли;
	
	Возврат ПолучитьСтрокуИзДвоичныхДанных(Base64Значение(СтрокаBase64), "UTF-8");
	
КонецФункции

#КонецОбласти